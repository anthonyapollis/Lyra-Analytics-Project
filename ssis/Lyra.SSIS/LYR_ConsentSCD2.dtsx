    <DTS:Executable DTS:CreationName="Microsoft.ExecuteSQLTask" DTS:DTSID="{367FA7AD-0B6A-402F-A1E6-401BECE98CF3}" DTS:ExecutableType="Microsoft.ExecuteSQLTask" DTS:LocaleID="-1" DTS:ObjectName="SQL Expire changed versions and insert new versions" DTS:refId="Package\SQL Expire changed versions and insert new versions" DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2014; © 2014 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1">
      <DTS:ObjectData>
        <SQLTask:SqlTaskData SQLTask:Connection="LyraDW_SSIS" SQLTask:SqlStatementSource="&#xA;SET XACT_ABORT ON;&#xA;BEGIN TRANSACTION;&#xA;UPDATE d&#xA;   SET EffectiveToDate = DATEADD(day, -1, c.SnapshotDate),&#xA;       IsCurrent = 0&#xA;FROM dw.DimConsent d&#xA;JOIN stg.ConsentChanged c ON c.ConsentKey = d.ConsentKey&#xA;WHERE d.IsCurrent = 1;&#xA;&#xA;INSERT INTO dw.DimConsent (EmployeeNaturalKey, CountryCode, ConsentType, ConsentStatus, ConsentChannel, ChangeReason,&#xA;                           RowHash, EffectiveFromDate, EffectiveToDate, IsCurrent, LoadRunId)&#xA;SELECT EmployeeNaturalKey, CountryCode, ConsentType, ConsentStatus, ConsentChannel, ChangeReason,&#xA;       RowHash, SnapshotDate, '9999-12-31', 1, ?&#xA;FROM stg.ConsentChanged;&#xA;COMMIT TRANSACTION;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
          <SQLTask:ParameterBinding SQLTask:DataType="3" SQLTask:DtsVariableName="User::RunId" SQLTask:ParameterDirection="Input" SQLTask:ParameterName="0" SQLTask:ParameterSize="0" />
        </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable DTS:CreationName="Microsoft.ExpressionTask" DTS:DTSID="{F4E2F8DA-4880-4160-BB1F-5AE49B41CD5F}" DTS:ExecutableType="Microsoft.ExpressionTask" DTS:LocaleID="-1" DTS:ObjectName="EXP Rows written _ new members + new versions" DTS:refId="Package\EXP Rows written _ new members + new versions" DTS:TaskContact="Expression Task;Microsoft Corporation; SQL Server 2014; © 2014 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1">
      <DTS:ObjectData>
        <ExpressionTask Expression="@[User::RowsWritten] = @[User::NewMembers] + @[User::ChangedRows]" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable DTS:CreationName="Microsoft.ExecuteSQLTask" DTS:DTSID="{DDB6CDFD-AB95-47CF-9894-9884167E8368}" DTS:ExecutableType="Microsoft.ExecuteSQLTask" DTS:LocaleID="-1" DTS:ObjectName="SQL Log run success" DTS:refId="Package\SQL Log run success" DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2014; © 2014 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1">
      <DTS:ObjectData>
        <SQLTask:SqlTaskData SQLTask:Connection="LyraDW_SSIS" SQLTask:SqlStatementSource="UPDATE etl.PackageRun SET EndTime = SYSDATETIME(), Status = 'Succeeded', RowsRead = ?, RowsWritten = ?, RowsRejected = 0, Message = CONCAT('snapshot ', ?, ': new members ', ?, ', new versions ', ?, ', unchanged ', ?) WHERE RunId = ?;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
          <SQLTask:ParameterBinding SQLTask:DataType="3" SQLTask:DtsVariableName="User::RowsRead" SQLTask:ParameterDirection="Input" SQLTask:ParameterName="0" SQLTask:ParameterSize="0" />
          <SQLTask:ParameterBinding SQLTask:DataType="3" SQLTask:DtsVariableName="User::RowsWritten" SQLTask:ParameterDirection="Input" SQLTask:ParameterName="1" SQLTask:ParameterSize="0" />
          <SQLTask:ParameterBinding SQLTask:DataType="130" SQLTask:DtsVariableName="User::SnapshotDate" SQLTask:ParameterDirection="Input" SQLTask:ParameterName="2" SQLTask:ParameterSize="10" />
          <SQLTask:ParameterBinding SQLTask:DataType="3" SQLTask:DtsVariableName="User::NewMembers" SQLTask:ParameterDirection="Input" SQLTask:ParameterName="3" SQLTask:ParameterSize="0" />
          <SQLTask:ParameterBinding SQLTask:DataType="3" SQLTask:DtsVariableName="User::ChangedRows" SQLTask:ParameterDirection="Input" SQLTask:ParameterName="4" SQLTask:ParameterSize="0" />
          <SQLTask:ParameterBinding SQLTask:DataType="3" SQLTask:DtsVariableName="User::UnchangedRows" SQLTask:ParameterDirection="Input" SQLTask:ParameterName="5" SQLTask:ParameterSize="0" />
          <SQLTask:ParameterBinding SQLTask:DataType="3" SQLTask:DtsVariableName="User::RunId" SQLTask:ParameterDirection="Input" SQLTask:ParameterName="6" SQLTask:ParameterSize="0" />
        </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
