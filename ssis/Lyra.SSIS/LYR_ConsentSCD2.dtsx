    <DTS:Executable DTS:CreationName="Microsoft.ExecuteSQLTask" DTS:DTSID="{DFCAC8E1-9843-40B4-8E1F-F5281F885BE4}" DTS:ExecutableType="Microsoft.ExecuteSQLTask" DTS:LocaleID="-1" DTS:ObjectName="SQL Resolve snapshot from parameters or etl_Config" DTS:refId="Package\SQL Resolve snapshot from parameters or etl_Config" DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2014; © 2014 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1">
      <DTS:ObjectData>
        <SQLTask:SqlTaskData SQLTask:Connection="LyraDW_SSIS" SQLTask:ResultType="ResultSetType_SingleRow" SQLTask:SqlStatementSource="&#xA;SET NOCOUNT ON;&#xA;DECLARE @file nvarchar(400) = COALESCE(NULLIF(?, N''), (SELECT ConfigValue FROM etl.Config WHERE ConfigKey = 'SnapshotFile'));&#xA;DECLARE @date nvarchar(10)  = COALESCE(NULLIF(?, N''), (SELECT ConfigValue FROM etl.Config WHERE ConfigKey = 'SnapshotDate'));&#xA;DECLARE @folder nvarchar(400) = (SELECT ConfigValue FROM etl.Config WHERE ConfigKey = 'DataFolder');&#xA;IF @file IS NULL OR TRY_CONVERT(date, @date, 23) IS NULL&#xA;    THROW 50010, 'Snapshot not configured: pass SnapshotFile and SnapshotDate (yyyy-MM-dd) or run ssis\run_ssis.ps1 -Snapshot.', 1;&#xA;IF @file NOT LIKE '%\%' SET @file = CONCAT(@folder, '\', @file);&#xA;SELECT @file AS SnapshotPath, @date AS SnapshotDate;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
          <SQLTask:ParameterBinding SQLTask:DataType="130" SQLTask:DtsVariableName="User::SnapshotFileParam" SQLTask:ParameterDirection="Input" SQLTask:ParameterName="0" SQLTask:ParameterSize="400" />
          <SQLTask:ParameterBinding SQLTask:DataType="130" SQLTask:DtsVariableName="User::SnapshotDateParam" SQLTask:ParameterDirection="Input" SQLTask:ParameterName="1" SQLTask:ParameterSize="10" />
          <SQLTask:ResultBinding SQLTask:DtsVariableName="User::SnapshotPath" SQLTask:ResultName="0" />
          <SQLTask:ResultBinding SQLTask:DtsVariableName="User::SnapshotDate" SQLTask:ResultName="1" />
        </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
